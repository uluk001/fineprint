{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "vite/client", "node"],
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "extension", "web", "tests", "vite.config.ts"]
}
